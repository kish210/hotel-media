<?xml version="1.0" encoding="utf-8"?>
<!--
  سیاست‌هایی که مدیر دستگاه اعلام می‌کند.

  عمدا کوتاه است: چیزی که واقعا لازم داریم قفل‌کردن اپ و جلوگیری از
  ریست است، نه رمزگذاری یا پاک‌کردن از راه دور. اعلام سیاست‌های
  اضافه فقط سطح حمله را بزرگ می‌کند.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- برای اینکه خروج از اپ ممکن نباشد -->
        <limit-password/>
        <!-- برای اینکه مهمان نتواند تلویزیون را ریست کند -->
        <wipe-data/>
        <force-lock/>
    </uses-policies>
</device-admin>
