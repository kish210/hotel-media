.env
vendor/
node_modules/
storage/logs/*.log
storage/cache/*
storage/temp/*
# نشست‌های ورود کاربران — هرگز نباید در مخزن برود
storage/sessions/*
!storage/sessions/.gitkeep
public/uploads/media/*
public/uploads/thumbnails/*
!public/uploads/media/.gitkeep
!public/uploads/thumbnails/.gitkeep
*.DS_Store
Thumbs.db
*.swp

nul

push-to-github.ps1

# Native installer build artifacts (PHP/MariaDB/NSSM are downloaded at build time)
dist/
installer/native/Output/
installer/hotelmedia/Output/
# Generated at build time (compiled tray + icon)
installer/hotelmedia/tray/HotelMediaTray.exe
installer/hotelmedia/**/hotelmedia.ico
