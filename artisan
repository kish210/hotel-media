    'db:migrate' => (function() {
        $db = \App\Core\Database::getInstance();

        // جدول ردیابی — هر فایل فقط یک‌بار اجرا می‌شود
        $db->query("CREATE TABLE IF NOT EXISTS schema_migrations (
            filename   VARCHAR(190) NOT NULL,
            applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            PRIMARY KEY (filename)
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");

        $applied = array_column(
            $db->rows('SELECT filename FROM schema_migrations') ?: [],
            'filename'
        );

        $files = glob(ROOT_PATH . '/database/migrations/*.sql') ?: [];
        sort($files, SORT_NATURAL);

        $ran = 0;
        foreach ($files as $file) {
            $name = basename($file);

            // 001_initial_schema نسخه قدیمی 001_complete_schema است — رد می‌شود
            if ($name === '001_initial_schema.sql') continue;
            if (in_array($name, $applied, true)) continue;

            echo "\033[36m→ $name\033[0m\n";
            $sql    = (string)file_get_contents($file);
            $failed = false;

            foreach (splitSqlStatements($sql) as $stmt) {
                try {
                    $db->query($stmt);
                } catch (\Throwable $e) {
                    $msg = $e->getMessage();

                    // فقط خطاهای «از قبل ساخته شده» روی نصب‌های قدیمی بی‌ضررند.
                    // با کد SQLSTATE تشخیص داده می‌شوند، نه با متن پیام — وگرنه
                    // خطاهای واقعی (مثل «Duplicate column name» در یک SELECT معیوب)
                    // هم به‌اشتباه نادیده گرفته می‌شوند.
                    $benign = [
                        '42S01',  // Base table or view already exists
                        '42000',  // ... CREATE INDEX روی ایندکس موجود
                    ];
                    $isDuplicateColumn = str_contains($msg, '1060 Duplicate column name')
                        && preg_match('/^\s*ALTER\s+TABLE/i', $stmt);

                    if (in_array($e->getCode(), $benign, true) || $isDuplicateColumn) {
                        continue;
                    }

                    $failed = true;
                    echo "  \033[31m✗ " . $msg . "\033[0m\n";
                }
            }

            if (!$failed) {
                $db->query('INSERT IGNORE INTO schema_migrations (filename) VALUES (?)', [$name]);
                echo "  \033[32m✓ اعمال شد\033[0m\n";
                $ran++;
            } else {
                echo "  \033[33m! ناقص — دوباره تلاش خواهد شد\033[0m\n";
            }
        }

        echo $ran ? "\nMigration done — $ran فایل اعمال شد.\n" : "\nهمه migration ها از قبل اعمال شده‌اند.\n";
    })(),

    'db:seed' => (function() {
        $db = \App\Core\Database::getInstance();
        $sql = file_get_contents(ROOT_PATH . '/database/seeds/seed.sql');
        foreach (array_filter(array_map('trim', explode(';', $sql))) as $stmt) {
            if ($stmt) {
                try { $db->query($stmt); }
                catch (\Throwable $e) { echo "  ✗ " . $e->getMessage() . "\n"; }
            }
        }
        echo "Seed done.\n";
    })(),

    'user:create' => (function() use ($argv) {
        $name  = $argv[2] ?? readline('Name: ');
        $email = $argv[3] ?? readline('Email: ');
        $pwd   = $argv[4] ?? readline('Password: ');
        $role  = $argv[5] ?? 'admin';
        $db    = \App\Core\Database::getInstance();
        $hash  = password_hash($pwd, PASSWORD_BCRYPT, ['cost' => 12]);
        $db->insert('users', ['tenant_id'=>1,'name'=>$name,'email'=>$email,'password'=>$hash,'role'=>$role,'is_active'=>1]);
        echo "User created: $email\n";
    })(),

    'key:generate' => (function() {
        $key = 'base64:' . base64_encode(random_bytes(32));
        echo "APP_KEY=$key\n";
        echo "Add this to your .env file\n";
    })(),

    'ws:start' => (function() {
        passthru('php ' . ROOT_PATH . '/websocket/server.php');
    })(),

    'storage:clean' => (function() {
        $db   = \App\Core\Database::getInstance();
        $rows = $db->rows("SELECT file_path,thumbnail_path FROM media WHERE deleted_at IS NOT NULL");
        $n = 0;
        foreach ($rows as $r) {
            foreach ([$r['file_path'],$r['thumbnail_path']] as $f) {
                if ($f && file_exists(PUBLIC_PATH.$f)) { unlink(PUBLIC_PATH.$f); $n++; }
            }
        }
        $db->query("DELETE FROM media WHERE deleted_at IS NOT NULL AND deleted_at < DATE_SUB(NOW(), INTERVAL 7 DAY)");
        echo "Cleaned $n files.\n";
    })(),

    'epg:sync' => (function() use ($argv) {
        // برای اجرای زمان‌بندی‌شده: روزی یک‌بار در Task Scheduler / cron
        //   php artisan epg:sync          همه منابع فعال همه tenant ها
        //   php artisan epg:sync 3        فقط tenant شماره ۳
        $tenantId = isset($argv[2]) ? (int)$argv[2] : null;

        $svc     = new \App\Services\EpgSyncService();
        $results = $svc->syncAll($tenantId);

        if (!$results) { echo "هیچ منبع EPG فعالی تعریف نشده است.\n"; return; }

        $failed = 0;
        foreach ($results as $r) {
            if ($r['ok']) {
                printf("  \033[32m✓\033[0m %-28s %s\n", $r['source'], $r['message']);
            } else {
                $failed++;
                printf("  \033[31m✗\033[0m %-28s %s\n", $r['source'], $r['message']);
            }
        }

        echo "\n" . count($results) . " منبع پردازش شد"
           . ($failed ? "، \033[31m$failed ناموفق\033[0m" : '') . ".\n";

        if ($failed) exit(1);
    })(),

    'news:sync' => (function() use ($argv) {
        // دریافت خبر از منابع RSS. برای cron: هر یک ساعت.
        //   php artisan news:sync [tenantId]
        $tenantId = isset($argv[2]) ? (int)$argv[2] : null;

        $res = (new \App\Services\NewsFeedService())->syncAll($tenantId);
        echo "  {$res['message']}\n";

        if ($res['failed'] > 0) exit(1);
    })(),

    'tvheadend:setup' => (function() use ($argv) {
        // ثبت خودکار TVHeadend و همگام‌سازی کانال‌ها.
        // نصب‌کننده‌ی production بعد از نصب TVHeadend این را صدا می‌زند تا
        // اپراتور هیچ کار دستی برای وصل کردنش نداشته باشد.
        //   php artisan tvheadend:setup [url] [user] [pass] [tenantId]
        $url  = $argv[2] ?? 'http://127.0.0.1:9981';
        $user = $argv[3] ?? '';
        $pass = $argv[4] ?? '';
        $tid  = isset($argv[5]) ? (int)$argv[5] : 1;

        $svc = new \App\Services\TvheadendService();

        echo "  بررسی $url …\n";
        $probe = $svc->probe($url, $user, $pass);
        if (!$probe['ok']) {
            echo "  \033[31m✗ {$probe['message']}\033[0m\n";
            echo "    بررسی کنید سرویس بالا باشد:  systemctl status tvheadend\n";
            exit(1);
        }
        echo "  \033[32m✓ {$probe['message']}\033[0m\n";

        $res = $svc->autoRegister($tid, $url, $user, $pass);
        if (!$res['ok']) {
            echo "  \033[31m✗ {$res['message']}\033[0m\n";
            exit(1);
        }

        echo "  \033[32m✓ {$res['message']}\033[0m\n";

        if ($res['channels'] === 0) {
            echo "\n  \033[33m! هنوز کانالی در TVHeadend تعریف نشده.\033[0m\n";
            echo "    وارد http://<server>:9981 شوید، در Configuration → DVB Inputs\n";
            echo "    شبکه و تیونر را تنظیم و اسکن کنید، سپس دوباره اجرا کنید.\n";
        }
    })(),

    'tvheadend:health' => (function() {
        $rows = (new \App\Services\TvheadendService())->health();
        if (!$rows) { echo "هیچ منبع TVHeadend فعالی تعریف نشده.\n"; return; }

        $down = 0;
        foreach ($rows as $r) {
            printf(
                "  %s %-34s %s  (%d کانال)\n",
                $r['online'] ? "\033[32m✓\033[0m" : "\033[31m✗\033[0m",
                $r['name'], $r['url'], $r['channels']
            );
            if (!$r['online']) { $down++; echo "      {$r['message']}\n"; }
        }

        if ($down) exit(1);
    })(),

    'multicast:start' => (function() use ($argv) {
        /* همه‌ی کانال‌هایی که آدرس multicast دارند را روی تی‌وی‌هدند
           روشن می‌کند.

           چرا لازم است: جریان‌های UDP با ریستارت سرور یا تی‌وی‌هدند
           از بین می‌روند. تلویزیون‌ها تصویر سیاه نشان می‌دهند و هیچ
           خطایی هم جایی ثبت نمی‌شود — از بیرون شبیه خرابی شبکه است.

           برای cron: هر ۵ دقیقه. شروع دوباره‌ی جریانی که از قبل روشن
           است بی‌ضرر است، پس اجرای مکرر مشکلی ندارد.

           خط cron (ستاره‌ی اول با اسلش، اینجا عمدا نوشته نشده چون
           دنباله‌ی ستاره-اسلش کامنت PHP را می‌بندد):

               هر پنج دقیقه →  cd /var/www/hotel-media
                               php artisan multicast:start
        */
        $tenant = (int)($argv[2] ?? 1);
        $svc    = new \App\Services\TvheadendApiService();
        $r      = $svc->startAll($tenant);

        printf("  \033[32m✓\033[0m %d جریان روشن است\n", $r['started']);
        if ($r['failed']) {
            printf("  \033[31m✗\033[0m %d ناموفق\n", $r['failed']);
            foreach (array_slice($r['errors'], 0, 10) as $e) echo "      $e\n";
            exit(1);
        }
    })(),

    'tvheadend:status' => (function() use ($argv) {
        /* تیونرهای مشغول و اشتراک‌های در حال پخش.
           مهم‌ترین عددی که اپراتور هتل لازم دارد: چند تیونر آزاد
           مانده. وقتی همه مشغول‌اند کانال بعدی پخش نمی‌شود و علتش
           از بیرون شبیه خرابی شبکه به نظر می‌رسد. */
        $tenant = (int)($argv[2] ?? 1);
        $svc    = new \App\Services\TvheadendApiService();

        $src = $svc->source($tenant);
        if (!$src) { echo "منبع تی‌وی‌هدند تنظیم نشده است.\n"; exit(1); }

        $st = $svc->liveStatus($src);
        if (!$st['ok']) { echo "\033[31m✗\033[0m {$st['message']}\n"; exit(1); }

        echo "\n  \033[36mتیونرها\033[0m\n";
        foreach ($st['inputs'] as $in) {
            printf("    %-34s %s\n", $in['input'] ?? '—', $in['stream'] ?? '');
        }

        printf("\n  \033[36maشتراک‌های فعال: %d\033[0m\n", count($st['subscriptions']));
        foreach ($st['subscriptions'] as $s) {
            printf("    %-30s %s\n", $s['channel'] ?? '—', $s['state'] ?? '');
        }

        $ts = $svc->timeshiftStatus($src);
        if ($ts['ok']) {
            echo "\n  تایم‌شیفت: " . ($ts['enabled']
                ? "\033[32mفعال\033[0m"
                : "\033[33mخاموش — مکث روی پخش زنده کار نمی‌کند\033[0m") . "\n";
        }
        echo "\n";
    })(),

    'pms:push' => (function() use ($argv) {
        // اقلام صورتحساب را به سیستم هتلداری می‌فرستد.
        // برای cron: هر ۵ دقیقه — قلم‌هایی که PMS در دسترس نبوده در صف
        // مانده‌اند و اینجا دوباره تلاش می‌شوند.
        //   php artisan pms:push        همه tenant ها
        //   php artisan pms:push 3      فقط tenant شماره ۳
        $tenantId = isset($argv[2]) ? (int)$argv[2] : null;

        $res = (new \App\Services\PmsChargeService())->pushPending($tenantId);

        printf(
            "  ارسال‌شده: %d   ناموفق: %d   رد‌شده: %d\n",
            $res['sent'], $res['failed'], $res['skipped']
        );
        echo "  {$res['message']}\n";

        if ($res['failed'] > 0) exit(1);
    })(),

    'test' => (function() {
        // تست‌های Feature اسکریپت‌های مستقل PHP هستند و به دیتابیس زنده وصل می‌شوند.
        // قبل از اجرا مطمئن شوید .env به یک دیتابیس تست اشاره می‌کند، نه production.
        $files = glob(ROOT_PATH . '/tests/Feature/*Test.php') ?: [];
        sort($files, SORT_NATURAL);

        if (!$files) { echo "هیچ تستی پیدا نشد.\n"; return; }

        $php    = PHP_BINARY;
        $failed = [];

        foreach ($files as $file) {
            $name = basename($file);
            echo "\n\033[36m══ $name ══\033[0m\n";

            $cmd = escapeshellarg($php) . ' ' . escapeshellarg($file);
            passthru($cmd, $code);

            if ($code !== 0) $failed[] = $name;
        }

        // تست‌های Node:
        //   tv-platform-sim  — شبیه‌سازی APIهای Tizen / webOS / Android
        //   tv-compat-lint   — ویژگی‌های مرورگری که روی تلویزیون هتل نیست
        //
        // دومی مهم‌تر از چیزی است که به نظر می‌رسد: کد ES6 یا CSS مدرن روی
        // webOS 3 و Tizen 2.3 خطای کنسول نمی‌دهد — صفحه فقط سیاه می‌ماند
        // و تا وقتی مهمان شکایت نکند کسی نمی‌فهمد.
        $nodeTests = [
            'tv-platform-sim.js',
            'tv-compat-lint.js',
            'php-syntax.js',
        ];

        // Node ممکن است روی سرور هتل نصب نباشد — تست‌ها رد می‌شوند نه شکست
        exec('node --version 2>&1', $out, $hasNode);

        foreach ($nodeTests as $name) {
            $path = ROOT_PATH . '/tests/Support/' . $name;
            if (!is_file($path)) continue;

            echo "\n\033[36m══ {$name} ══\033[0m\n";
            if ($hasNode !== 0) {
                echo "  \033[33m⏭ Node نصب نیست — این تست رد شد\033[0m\n";
                continue;
            }
            passthru(escapeshellarg('node') . ' ' . escapeshellarg($path), $code);
            if ($code !== 0) $failed[] = $name;
            $files[] = $path;
        }

        echo "\n" . str_repeat('═', 50) . "\n";
        if ($failed) {
            echo "\033[31m✗ " . count($failed) . " تست شکست خورد: " . implode(', ', $failed) . "\033[0m\n";
            exit(1);
        }
        echo "\033[32m✓ همه " . count($files) . " فایل تست پاس شدند\033[0m\n";
    })(),

    'cache:clear' => (function() {
        array_map('unlink', glob(STORAGE_PATH.'/cache/*'));
        echo "Cache cleared.\n";
    })(),

