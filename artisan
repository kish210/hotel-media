#!/usr/bin/env php
<?php
define('ROOT_PATH',   __DIR__);
define('APP_PATH',    ROOT_PATH . '/app');
define('CONFIG_PATH', ROOT_PATH . '/config');
define('VIEWS_PATH',  ROOT_PATH . '/resources/views');
define('STORAGE_PATH',ROOT_PATH . '/storage');
define('PUBLIC_PATH', ROOT_PATH . '/public');

spl_autoload_register(function(string $class): void {
    $path = APP_PATH . '/' . str_replace(['App\\','\\'], ['','/'], $class) . '.php';
    if (file_exists($path)) require $path;
});

// Load env
$envFile = ROOT_PATH . '/.env';
if (file_exists($envFile)) {
    foreach (file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $line) {
        if (str_starts_with(trim($line), '#') || !str_contains($line, '=')) continue;
        [$k,$v] = explode('=', $line, 2);
        $_ENV[trim($k)] = trim($v, " \t\n\r\"'");
    }
}
function env(string $k, mixed $d=null): mixed { $v=$_ENV[$k]??getenv($k)?:$d; if($v==='true')return true; if($v==='false')return false; return $v; }

// همان منطقه زمانی که public/index.php اعمال می‌کند — تا date() در CLI و وب یکی باشد
date_default_timezone_set((string)env('APP_TIMEZONE', 'Asia/Tehran'));
function request(): object { return new class { public function ip():string{return '127.0.0.1';} public function userAgent():string{return 'CLI';} public function isJson():bool{return false;} public function isAjax():bool{return false;} }; }

/**
 * تقسیم فایل SQL به دستورهای مجزا — نقطه‌ویرگول داخل رشته و کامنت نادیده گرفته می‌شود
 * @return string[]
 */
function splitSqlStatements(string $sql): array
{
    $statements = [];
    $current    = '';
    $len        = strlen($sql);
    $quote      = null;   // ' یا " یا ` وقتی داخل رشته هستیم
    $comment    = null;   // 'line' یا 'block'

    for ($i = 0; $i < $len; $i++) {
        $ch   = $sql[$i];
        $next = $sql[$i + 1] ?? '';

        if ($comment === 'line') {
            if ($ch === "\n") { $comment = null; $current .= $ch; }
            continue;
        }
        if ($comment === 'block') {
            if ($ch === '*' && $next === '/') { $comment = null; $i++; }
            continue;
        }

        if ($quote === null) {
            if (($ch === '-' && $next === '-') || $ch === '#') { $comment = 'line';  continue; }
            if ($ch === '/' && $next === '*')                  { $comment = 'block'; $i++; continue; }

            if ($ch === "'" || $ch === '"' || $ch === '`') { $quote = $ch; }
            elseif ($ch === ';') {
                $stmt = trim($current);
                if ($stmt !== '') $statements[] = $stmt;
                $current = '';
                continue;
            }
        } else {
            // فرار با بک‌اسلش فقط داخل رشته‌های ' و " معنا دارد
            if ($ch === '\\' && $quote !== '`') { $current .= $ch . $next; $i++; continue; }
            if ($ch === $quote) { $quote = null; }
        }

        $current .= $ch;
    }

    $last = trim($current);
    if ($last !== '') $statements[] = $last;

    return $statements;
}

$command = $argv[1] ?? 'help';

match ($command) {
    'monitor:screens' => (function() {
        $svc = new \App\Services\ScreenMonitorService();
        $svc->run();
    })(),

    'db:migrate' => (function() {
        $db = \App\Core\Database::getInstance();

        // جدول ردیابی — هر فایل فقط یک‌بار اجرا می‌شود
        $db->query("CREATE TABLE IF NOT EXISTS schema_migrations (
            filename   VARCHAR(190) NOT NULL,
            applied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            PRIMARY KEY (filename)
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");

        $applied = array_column(
            $db->rows('SELECT filename FROM schema_migrations') ?: [],
            'filename'
        );

        $files = glob(ROOT_PATH . '/database/migrations/*.sql') ?: [];
        sort($files, SORT_NATURAL);

        $ran = 0;
        foreach ($files as $file) {
            $name = basename($file);

            // 001_initial_schema نسخه قدیمی 001_complete_schema است — رد می‌شود
            if ($name === '001_initial_schema.sql') continue;
            if (in_array($name, $applied, true)) continue;

            echo "\033[36m→ $name\033[0m\n";
            $sql    = (string)file_get_contents($file);
            $failed = false;

            foreach (splitSqlStatements($sql) as $stmt) {
                try {
                    $db->query($stmt);
                } catch (\Throwable $e) {
                    $msg = $e->getMessage();

                    // فقط خطاهای «از قبل ساخته شده» روی نصب‌های قدیمی بی‌ضررند.
                    // با کد SQLSTATE تشخیص داده می‌شوند، نه با متن پیام — وگرنه
                    // خطاهای واقعی (مثل «Duplicate column name» در یک SELECT معیوب)
                    // هم به‌اشتباه نادیده گرفته می‌شوند.
                    $benign = [
                        '42S01',  // Base table or view already exists
                        '42000',  // ... CREATE INDEX روی ایندکس موجود
                    ];
                    $isDuplicateColumn = str_contains($msg, '1060 Duplicate column name')
                        && preg_match('/^\s*ALTER\s+TABLE/i', $stmt);

                    if (in_array($e->getCode(), $benign, true) || $isDuplicateColumn) {
                        continue;
                    }

                    $failed = true;
                    echo "  \033[31m✗ " . $msg . "\033[0m\n";
                }
            }

            if (!$failed) {
                $db->query('INSERT IGNORE INTO schema_migrations (filename) VALUES (?)', [$name]);
                echo "  \033[32m✓ اعمال شد\033[0m\n";
                $ran++;
            } else {
                echo "  \033[33m! ناقص — دوباره تلاش خواهد شد\033[0m\n";
            }
        }

        echo $ran ? "\nMigration done — $ran فایل اعمال شد.\n" : "\nهمه migration ها از قبل اعمال شده‌اند.\n";
    })(),

    'db:seed' => (function() {
        $db = \App\Core\Database::getInstance();
        $sql = file_get_contents(ROOT_PATH . '/database/seeds/seed.sql');
        foreach (array_filter(array_map('trim', explode(';', $sql))) as $stmt) {
            if ($stmt) {
                try { $db->query($stmt); }
                catch (\Throwable $e) { echo "  ✗ " . $e->getMessage() . "\n"; }
            }
        }
        echo "Seed done.\n";
    })(),

    'user:create' => (function() use ($argv) {
        $name  = $argv[2] ?? readline('Name: ');
        $email = $argv[3] ?? readline('Email: ');
        $pwd   = $argv[4] ?? readline('Password: ');
        $role  = $argv[5] ?? 'admin';
        $db    = \App\Core\Database::getInstance();
        $hash  = password_hash($pwd, PASSWORD_BCRYPT, ['cost' => 12]);
        $db->insert('users', ['tenant_id'=>1,'name'=>$name,'email'=>$email,'password'=>$hash,'role'=>$role,'is_active'=>1]);
        echo "User created: $email\n";
    })(),

    'key:generate' => (function() {
        $key = 'base64:' . base64_encode(random_bytes(32));
        echo "APP_KEY=$key\n";
        echo "Add this to your .env file\n";
    })(),

    'ws:start' => (function() {
        passthru('php ' . ROOT_PATH . '/websocket/server.php');
    })(),

    'storage:clean' => (function() {
        $db   = \App\Core\Database::getInstance();
        $rows = $db->rows("SELECT file_path,thumbnail_path FROM media WHERE deleted_at IS NOT NULL");
        $n = 0;
        foreach ($rows as $r) {
            foreach ([$r['file_path'],$r['thumbnail_path']] as $f) {
                if ($f && file_exists(PUBLIC_PATH.$f)) { unlink(PUBLIC_PATH.$f); $n++; }
            }
        }
        $db->query("DELETE FROM media WHERE deleted_at IS NOT NULL AND deleted_at < DATE_SUB(NOW(), INTERVAL 7 DAY)");
        echo "Cleaned $n files.\n";
    })(),

    'epg:sync' => (function() use ($argv) {
        // برای اجرای زمان‌بندی‌شده: روزی یک‌بار در Task Scheduler / cron
        //   php artisan epg:sync          همه منابع فعال همه tenant ها
        //   php artisan epg:sync 3        فقط tenant شماره ۳
        $tenantId = isset($argv[2]) ? (int)$argv[2] : null;

        $svc     = new \App\Services\EpgSyncService();
        $results = $svc->syncAll($tenantId);

        if (!$results) { echo "هیچ منبع EPG فعالی تعریف نشده است.\n"; return; }

        $failed = 0;
        foreach ($results as $r) {
            if ($r['ok']) {
                printf("  \033[32m✓\033[0m %-28s %s\n", $r['source'], $r['message']);
            } else {
                $failed++;
                printf("  \033[31m✗\033[0m %-28s %s\n", $r['source'], $r['message']);
            }
        }

        echo "\n" . count($results) . " منبع پردازش شد"
           . ($failed ? "، \033[31m$failed ناموفق\033[0m" : '') . ".\n";

        if ($failed) exit(1);
    })(),

    'test' => (function() {
        // تست‌های Feature اسکریپت‌های مستقل PHP هستند و به دیتابیس زنده وصل می‌شوند.
        // قبل از اجرا مطمئن شوید .env به یک دیتابیس تست اشاره می‌کند، نه production.
        $files = glob(ROOT_PATH . '/tests/Feature/*Test.php') ?: [];
        sort($files, SORT_NATURAL);

        if (!$files) { echo "هیچ تستی پیدا نشد.\n"; return; }

        $php    = PHP_BINARY;
        $failed = [];

        foreach ($files as $file) {
            $name = basename($file);
            echo "\n\033[36m══ $name ══\033[0m\n";

            $cmd = escapeshellarg($php) . ' ' . escapeshellarg($file);
            passthru($cmd, $code);

            if ($code !== 0) $failed[] = $name;
        }

        // شبیه‌سازی APIهای تلویزیون (Tizen / webOS / Android) با Node
        $sim = ROOT_PATH . '/tests/Support/tv-platform-sim.js';
        if (is_file($sim)) {
            echo "\n\033[36m══ tv-platform-sim.js ══\033[0m\n";

            // Node ممکن است روی سرور هتل نصب نباشد — تست رد می‌شود نه شکست
            exec('node --version 2>&1', $out, $hasNode);
            if ($hasNode !== 0) {
                echo "  \033[33m⏭ Node نصب نیست — این تست رد شد\033[0m\n";
            } else {
                passthru(escapeshellarg('node') . ' ' . escapeshellarg($sim), $code);
                if ($code !== 0) $failed[] = 'tv-platform-sim.js';
                $files[] = $sim;
            }
        }

        echo "\n" . str_repeat('═', 50) . "\n";
        if ($failed) {
            echo "\033[31m✗ " . count($failed) . " تست شکست خورد: " . implode(', ', $failed) . "\033[0m\n";
            exit(1);
        }
        echo "\033[32m✓ همه " . count($files) . " فایل تست پاس شدند\033[0m\n";
    })(),

    'cache:clear' => (function() {
        array_map('unlink', glob(STORAGE_PATH.'/cache/*'));
        echo "Cache cleared.\n";
    })(),

    default => (function() {
        echo "\033[36mSignageCMS Artisan CLI\033[0m\n\n";
        echo "\033[33mUsage:\033[0m php artisan <command>\n\n";
        echo "\033[33mCommands:\033[0m\n";
        $cmds = [
            'db:migrate'      => 'Run database migrations',
            'db:seed'         => 'Seed database with sample data',
            'user:create'     => 'Create a new user [name email password role]',
            'key:generate'    => 'Generate APP_KEY for .env',
            'monitor:screens' => 'Check screen online status & send alerts',
            'ws:start'        => 'Start WebSocket server',
            'storage:clean'   => 'Remove soft-deleted media files',
            'cache:clear'     => 'Clear application cache',
            'epg:sync'        => 'Sync EPG from TVHeadend / XMLTV sources [tenantId]',
            'test'            => 'Run feature tests (needs a TEST database in .env)',
        ];
        foreach ($cmds as $cmd => $desc) {
            printf("  \033[32m%-20s\033[0m %s\n", $cmd, $desc);
        }
        echo "\n";
    })(),
};
