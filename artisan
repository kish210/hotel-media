/**
 * تقسیم فایل SQL به دستورهای مجزا — نقطه‌ویرگول داخل رشته و کامنت نادیده گرفته می‌شود
 * @return string[]
 */
function splitSqlStatements(string $sql): array
{
    $statements = [];
    $current    = '';
    $len        = strlen($sql);
    $quote      = null;   // ' یا " یا ` وقتی داخل رشته هستیم
    $comment    = null;   // 'line' یا 'block'

    for ($i = 0; $i < $len; $i++) {
        $ch   = $sql[$i];
        $next = $sql[$i + 1] ?? '';

        if ($comment === 'line') {
            if ($ch === "\n") { $comment = null; $current .= $ch; }
            continue;
        }
        if ($comment === 'block') {
            if ($ch === '*' && $next === '/') { $comment = null; $i++; }
            continue;
        }

        if ($quote === null) {
            if (($ch === '-' && $next === '-') || $ch === '#') { $comment = 'line';  continue; }
            if ($ch === '/' && $next === '*')                  { $comment = 'block'; $i++; continue; }

            if ($ch === "'" || $ch === '"' || $ch === '`') { $quote = $ch; }
            elseif ($ch === ';') {
                $stmt = trim($current);
                if ($stmt !== '') $statements[] = $stmt;
                $current = '';
                continue;
            }
        } else {
            // فرار با بک‌اسلش فقط داخل رشته‌های ' و " معنا دارد
            if ($ch === '\\' && $quote !== '`') { $current .= $ch . $next; $i++; continue; }
            if ($ch === $quote) { $quote = null; }
        }

        $current .= $ch;
    }

    $last = trim($current);
    if ($last !== '') $statements[] = $last;

    return $statements;
}

$command = $argv[1] ?? 'help';

match ($command) {
    'monitor:screens' => (function() {
